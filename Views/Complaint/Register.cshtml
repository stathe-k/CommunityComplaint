@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="eyebrow-pill" style="margin-bottom:14px;">Step 1 of 2</div>
                <h2 class="mb-1">Report a Complaint</h2>
                <p class="text-muted mb-4">Tell us who you are — it only takes a moment.</p>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Yashshree Gite" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MobileNumber" class="form-label"></label>
                        <input asp-for="MobileNumber" class="form-control" placeholder="10-digit mobile number" maxlength="10" />
                        <span asp-validation-for="MobileNumber" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-2">Continue →</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
