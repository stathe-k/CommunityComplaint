@model ComplaintViewModel
@{
    ViewData["Title"] = "Submit Complaint";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card p-4">
            <h2>Complaint Details</h2>
            <p class="text-muted">Step 2 of 2 — describe the issue.</p>

            <form asp-action="Submit" method="post" enctype="multipart/form-data" id="complaintForm">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" class="form-select" id="categorySelect">
                        <option value="" style="color:black !important;">-- Select Category --</option>
                        @foreach (var cat in categories)
                        {
                            <option style="color:black !important;" value="@cat">@cat</option>
                        }
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="mb-3" id="otherCategoryWrap" style="display:none;">
                    <label asp-for="OtherCategoryText" class="form-label"></label>
                    <input asp-for="OtherCategoryText" class="form-control" placeholder="Tell us what kind of issue this is" />
                    <span asp-validation-for="OtherCategoryText" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the issue in detail"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-1">
                    <label asp-for="Location" class="form-label"></label>
                    <div class="d-flex gap-2">
                        <input asp-for="Location" class="form-control" id="locationInput" placeholder="Street, landmark, or area" />
                        <button type="button" class="btn locate-btn" id="locateBtn" onclick="detectLocation()">📍 Use GPS</button>
                    </div>
                    <span asp-validation-for="Location" class="text-danger"></span>
                    <div class="locate-status" id="locateStatus"></div>
                </div>

                <div class="mb-3 mt-3">
                    <label asp-for="Photo" class="form-label"></label>
                    <input asp-for="Photo" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                    <span asp-validation-for="Photo" class="text-danger"></span>
                    <div class="form-text">JPG or PNG, up to 2 MB.</div>
                </div>

                <button type="submit" class="btn btn-primary">Submit Complaint</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const categorySelect = document.getElementById('categorySelect');
        const otherWrap = document.getElementById('otherCategoryWrap');

        function syncOtherField(){
            otherWrap.style.display = categorySelect.value === 'Other' ? 'block' : 'none';
        }
        categorySelect.addEventListener('change', syncOtherField);
        syncOtherField();

        // ---- GPS location autofill ----
        function detectLocation(){
            const btn = document.getElementById('locateBtn');
            const status = document.getElementById('locateStatus');
            const input = document.getElementById('locationInput');

            if(!('geolocation' in navigator)){
                status.textContent = 'Geolocation is not supported by this browser.';
                status.classList.add('err');
                return;
            }

            btn.disabled = true;
            btn.textContent = '📍 Detecting…';
            status.classList.remove('err');
            status.textContent = 'Requesting location access…';

            navigator.geolocation.getCurrentPosition(async (pos) => {
                const { latitude, longitude } = pos.coords;
                status.textContent = 'Looking up the address…';
                try{
                    const res = await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${latitude}&longitude=${longitude}&localityLanguage=en`);
                    const data = await res.json();
                    const place = [data.locality, data.city, data.principalSubdivision].filter(Boolean).join(', ');
                    if(place){
                        input.value = place;
                        status.textContent = 'Location filled in from GPS. Feel free to adjust it.';
                    } else {
                        input.value = `Lat ${latitude.toFixed(5)}, Lon ${longitude.toFixed(5)}`;
                        status.textContent = 'Could not resolve an address — filled in coordinates instead.';
                    }
                }catch(err){
                    input.value = `Lat ${latitude.toFixed(5)}, Lon ${longitude.toFixed(5)}`;
                    status.textContent = 'Address lookup failed — filled in coordinates instead.';
                }finally{
                    btn.disabled = false;
                    btn.textContent = '📍 Use GPS';
                }
            }, (error) => {
                btn.disabled = false;
                btn.textContent = '📍 Use GPS';
                status.classList.add('err');
                status.textContent = error.code === error.PERMISSION_DENIED
                    ? 'Location access was denied. You can still type the location manually.'
                    : 'Could not detect your location. Please enter it manually.';
            }, { enableHighAccuracy: true, timeout: 10000 });
        }
    </script>
}
