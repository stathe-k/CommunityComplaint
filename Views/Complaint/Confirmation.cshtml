@model Complaint
@{
    ViewData["Title"] = "Complaint Submitted";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <div class="card">
            <div class="card-body">
                <div class="eyebrow-pill" style="margin: 0 auto 14px;">✓ Submitted</div>
                <h2 style="color: var(--accent);">Complaint Submitted!</h2>
                <p class="text-muted">Save your Complaint ID to track its status.</p>
                <h1 class="display-4 fw-bold my-3">#@Model.ComplaintId</h1>
                <dl class="row text-start mt-4">
                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.Category</dd>
                    <dt class="col-sm-4">Location</dt>
                    <dd class="col-sm-8">@Model.Location</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge bg-danger">@Model.Status</span></dd>
                    <dt class="col-sm-4">Submitted On</dt>
                    <dd class="col-sm-8">@Model.Date.ToString("dd MMM yyyy, hh:mm tt")</dd>
                </dl>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <a class="btn btn-outline-primary" asp-action="Track">Track This Complaint</a>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>
